{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "IcmsDatabase": "Host=localhost;Port=5433;Database=IcmsDb;Username=postgres;Password=YourDbPasswordHere"
  },
